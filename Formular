        <div class="tag-optional">OPTIONAL</div>
      </div>
    </div>

    <div class="step-actions" style="margin-top:1.6rem;">
      <button class="btn-ghost" data-back="2"><i class="ti ti-arrow-left"></i> Zurück</button>
      <button class="btn-primary" data-next="4">Weiter <i class="ti ti-arrow-right"></i></button>
    </div>
  </div>

  <!-- SCHRITT 4: KONTAKT -->
  <div class="step-card step-panel" data-step="4" style="display:none;">
    <div class="step-eyebrow">Schritt 4 von 4</div>
    <div class="step-title">Ihre Kontaktdaten</div>

    <div class="field-row field-group">
      <div>
        <label>Vorname</label>
        <input type="text" placeholder="Vorname">
      </div>
