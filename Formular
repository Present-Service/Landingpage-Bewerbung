<script>
const steps = ['Kategorie','Angaben','Unterlagen','Kontakt','Fertig'];
let current = 1;
let selectedCat = null;

const track = document.getElementById('progressTrack');
function renderProgress() {
  track.innerHTML = '';
  steps.forEach((label, i) => {
    const n = i + 1;
    const stepEl = document.createElement('div');
    stepEl.className = 'progress-step';
    const state = n < current ? 'done' : (n === current ? 'active' : '');
    stepEl.innerHTML = `
      <div class="dot ${state}">${n < current ? '<i class=\"ti ti-check\"></i>' : n}</div>
      <div class="progress-label ${n === current ? 'active' : ''}">${label}</div>
    `;
    track.appendChild(stepEl);
    if (n < steps.length) {
      const line = document.createElement('div');
      line.className = 'progress-line' + (n < current ? ' done' : '');
      track.appendChild(line);
    }
  });
  document.getElementById('navHint').textContent =
    current <= 4 ? `Bewerbungsformular · Schritt ${current} von 4` : 'Bewerbungsformular · Abgeschlossen';
}

function showStep(n) {
  document.querySelectorAll('.step-panel').forEach(p => {
    p.style.display = (parseInt(p.dataset.step) === n) ? '' : 'none';
  });
  current = n;
  renderProgress();
  window.scrollTo({ top: document.querySelector('.progress-wrap').offsetTop, behavior: 'smooth' });
}

const catLabels = {
  zahnarzt: 'Zahnarzt / Zahnärztin', dhph: 'DH / PH', da: 'DA', lehrling: 'Lehrling / Schnupperlehre'
};
const panelForCat = { zahnarzt: 'panel-fach', dhph: 'panel-fach', da: 'panel-da', lehrling: 'panel-lehrling' };

document.querySelectorAll('.cat-card').forEach(card => {
  card.addEventListener('click', () => {
    document.querySelectorAll('.cat-card').forEach(c => c.classList.remove('selected'));
    card.classList.add('selected');
    selectedCat = card.dataset.cat;
    document.getElementById('btnStep1Next').disabled = false;

    document.querySelectorAll('.cond-panel').forEach(p => p.classList.remove('visible'));
    document.getElementById(panelForCat[selectedCat]).classList.add('visible');
    document.getElementById('condHintText').textContent =
      `Angezeigte Felder gelten für: ${catLabels[selectedCat]}`;
  });
});

document.getElementById('btnStep1Next').addEventListener('click', () => showStep(2));
document.getElementById('btnSubmit').addEventListener('click', () => showStep(5));

document.querySelectorAll('[data-next]').forEach(btn => {
  btn.addEventListener('click', () => showStep(parseInt(btn.dataset.next)));
});
document.querySelectorAll('[data-back]').forEach(btn => {
  btn.addEventListener('click', () => showStep(parseInt(btn.dataset.back)));
});

renderProgress();
</script>

</body>
</html>
