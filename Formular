      <i class="ti ti-filter"></i> <span id="condHintText">Felder passen sich an Ihre Auswahl aus Schritt 1 an.</span>
    </div>

    <!-- Fachkraft-Felder: Zahnarzt / DH-PH -->
    <div class="cond-panel" id="panel-fach">
      <div class="field-row field-group">
        <div>
          <label>Fachrichtung</label>
          <select><option>Allgemeinzahnmedizin</option><option>Kieferorthopädie</option><option>Kinderzahnmedizin</option><option>Prophylaxe</option></select>
        </div>
        <div>
          <label>Pensum <span class="opt">(%)</span></label>
          <input type="number" placeholder="z. B. 80">
        </div>
      </div>
      <div class="field-row field-group">
        <div>
          <label>Verfügbar ab</label>
          <input type="date">
        </div>
        <div>
          <label>Berufserfahrung <span class="opt">(Jahre)</span></label>
          <input type="number" placeholder="z. B. 3">
        </div>
      </div>
    </div>

    <!-- DA-Felder -->
    <div class="cond-panel" id="panel-da">
      <div class="field-row field-group">
        <div>
          <label>Pensum <span class="opt">(%)</span></label>
          <input type="number" placeholder="z. B. 80">
        </div>
        <div>
          <label>Verfügbar ab</label>
          <input type="date">
        </div>
      </div>
      <div class="field-group">
        <label>Berufserfahrung <span class="opt">(Jahre)</span></label>
        <input type="number" placeholder="z. B. 2">
