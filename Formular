      <div class="confirm-meta">
        <span><i class="ti ti-mail"></i> Automatische Bestätigungsmail</span>
        <span><i class="ti ti-clock"></i> Antwort i. d. R. innert 5 Arbeitstagen</span>
      </div>
    </div>
  </div>

