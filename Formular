    <!-- Lehrling-Felder -->
    <div class="cond-panel" id="panel-lehrling">
      <div class="field-row field-group">
        <div>
          <label>Alter</label>
          <input type="number" placeholder="z. B. 16">
        </div>
        <div>
          <label>Schulstufe</label>
          <select><option>3. Sek</option><option>2. Sek</option><option>Bereits abgeschlossen</option></select>
