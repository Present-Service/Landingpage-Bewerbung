    <div class="step-actions" style="margin-top:0.6rem;">
      <button class="btn-ghost" data-back="1"><i class="ti ti-arrow-left"></i> Zurück</button>
      <button class="btn-primary" data-next="3">Weiter <i class="ti ti-arrow-right"></i></button>
    </div>
  </div>

  <!-- SCHRITT 3: UNTERLAGEN -->
  <div class="step-card step-panel" data-step="3" style="display:none;">
    <div class="step-eyebrow">Schritt 3 von 4</div>
    <div class="step-title">Unterlagen hochladen</div>
    <div class="step-sub">CV ist Pflicht. Ein kurzes Video ist optional, hilft uns aber, Sie besser kennenzulernen.</div>

    <div class="upload-grid">
      <div class="dropzone">
        <i class="ti ti-file-cv"></i>
